<Window x:Class="Guardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网课守护"
        Height="560"
        Width="760"
        MinHeight="520"
        MinWidth="680"
        Background="#F3F5F7">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="网课守护"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#1F2933" />
                <TextBlock Text="保护腾讯会议和本地课件，减少浏览器、游戏和聊天软件干扰。"
                           Margin="0,6,0,0"
                           Foreground="#5D6673" />
            </StackPanel>
            <Border x:Name="StatusBadge"
                    DockPanel.Dock="Right"
                    Padding="14,8"
                    CornerRadius="4"
                    Background="#EEF1F5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                <TextBlock x:Name="StatusBadgeText"
                           Text="网课模式：关闭"
                           FontWeight="SemiBold"
                           Foreground="#535D6C" />
            </Border>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,18"
                Padding="22"
                Background="White"
                BorderBrush="#DEE3EA"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="ModeTitle"
                               Text="当前未开启网课模式"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#222831" />
                    <TextBlock x:Name="ModeDescription"
                               Margin="0,8,0,0"
                               Foreground="#5D6673"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DaemonStatusText"
                               Margin="0,14,0,0"
                               Foreground="#5D6673"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button x:Name="ToggleButton"
                        Grid.Column="1"
                        Width="150"
                        Height="44"
                        Margin="26,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Click="ToggleButton_Click" />
            </Grid>
        </Border>

        <Grid x:Name="DetailPanel" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="20"
                    Background="White"
                    BorderBrush="#DEE3EA"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="允许内容"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#222831" />
                    <TextBlock Margin="0,12,0,0"
                               Foreground="#3E4650"
                               TextWrapping="Wrap"
                               Text="腾讯会议、资源管理器、本地图片、PDF、Word、PPT、Excel 和记事本等常见课件工具。" />
                    <TextBlock Margin="0,18,0,0"
                               Foreground="#5D6673"
                               TextWrapping="Wrap"
                               Text="程序不会主动拦截摄像头、麦克风、输入法、音频和系统必要组件。" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="20"
                    Background="White"
                    BorderBrush="#DEE3EA"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="家长提示"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#222831" />
                    <TextBlock Margin="0,12,0,0"
                               Foreground="#3E4650"
                               TextWrapping="Wrap"
                               Text="关闭网课模式和退出程序都需要家长密码。网课期间请保持本程序在托盘运行。" />
                    <TextBlock Margin="0,18,0,0"
                               Foreground="#5D6673"
                               TextWrapping="Wrap"
                               Text="如果上课需要临时打开其它工具，请由家长输入密码后处理。" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel x:Name="FooterPanel"
                   Grid.Row="3"
                   Margin="0,18,0,0">
            <Button Content="最近拦截记录"
                    Width="120"
                    Height="34"
                    DockPanel.Dock="Left"
                    Click="RecentLogs_Click" />
            <TextBlock x:Name="FooterText"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#697386" />
        </DockPanel>
    </Grid>
</Window>
